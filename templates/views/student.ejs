        </div>
    </div>





    <script>
        let btn = document.querySelector("#btn");
        let sidebar = document.querySelector(".sidebar");

        btn.onclick = function () {
            sidebar.classList.toggle("active");
        };

        // mode

        let modeToggle = document.querySelector("#mode-toggle");
        let body = document.body;
    
        btn.onclick = function () {
            sidebar.classList.toggle("active");
        };
    
        modeToggle.onclick = function () {
            body.classList.toggle("dark-mode");
            body.classList.toggle("light-mode");
    
            if(body.classList.contains("dark-mode")) {
                modeToggle.innerHTML = "<i class='bx bx-sun'></i><span class='nav-item'>Light Mode</span>";
            } else {
                modeToggle.innerHTML = "<i class='bx bx-moon'></i><span class='nav-item'>Dark Mode</span>";
            }
        };
    
        // Set initial mode
        body.classList.add("light-mode");
    </script>
    
