<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Module</title>
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link rel="stylesheet" href="/css/student.css">
</head>

<body>

    <div class="sidebar">
        <div class="top">
            <div class="logo">
                <i class="bx bxl-codepen"></i>
                <span>Student Dashboard</span>
            </div>
            <i class="bx bx-menu" id="btn"></i>
        </div>
        <div class="user">
            <% if (user && user.profilePicture) { %>
                <img src="<%= user.profilePicture %>" alt="Profile Picture" class="user-img">
            <% } else { %>
                <img src="https://static.vecteezy.com/system/resources/previews/007/469/004/non_2x/graduated-student-in-simple-flat-personal-profile-icon-or-symbol-people-concept-illustration-vector.jpg" alt="Profile Picture" class="user-img">
            <% } %>
            <div>
                <% if (user && user.name) { %>
                    <p><%= user.name %></p>
                <% } else { %>
                    <p>Default Username</p>
                <% } %>
            </div>
        </div>
        <ul>
            <li>
                <a href="./updateProfile">
                    <i class="bx bxs-grid-alt"></i>
                    <span class="nav-item">UpdateProfile</span>
                </a>
                <span class="tooltip">UpdateProfile</span>
            </li>
            <li>
                <a href="./AddEducation">
                    <i class='bx bx-data'></i>
                    <span class="nav-item">AddEducation</span>
                </a>
                <span class="tooltip">AddEducation</span>
            </li>
            <li>
                <a href="./skills">
                    <i class='bx bx-detail'></i>
                    <span class="nav-item">Skills</span>
                </a>
                <span class="tooltip">Skills</span>
            </li>
            <li>
                <a href="./appliedStatus">
                    <i class='bx bxs-id-card'></i>
                    <span class="nav-item">AppliedStatus</span>
                </a>
                <span class="tooltip">AppliedStatus</span>
            </li>
            <li>
                <a href="/">
                    <i class="bx bx-home"></i>
                    <span class="nav-item">Home</span>
                </a>
                <span class="tooltip">Home</span>
            </li>
            <li>
                <a href="./logout">
                    <i class="bx bx-log-out"></i>
                    <span class="nav-item">Logout</span>
                </a>
                <span class="tooltip">Logout</span>
            </li>
        </ul>
    </div>

    <div class="main-content">                
