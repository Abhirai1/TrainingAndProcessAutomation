<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Module</title>
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
</head>

<body>

    <div class="sidebar">
        <!-- Sidebar content -->
    </div>
    
    <div class="main-content">
        <h1>Upload Your Documents</h1>
        <form action="/uploadDocuments" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label for="10th">10th Marksheet (Percentage):</label>
                <input type="file" name="tenthMarksheet" id="10th" accept=".pdf,.jpg,.png" required>
                <input type="number" name="tenthPercentage" min="0" max="100" step="0.01" required>
            </div>
            <div class="form-group">
                <label for="12th">12th Marksheet (Percentage):</label>
                <input type="file" name="twelfthMarksheet" id="12th" accept=".pdf,.jpg,.png" required>
                <input type="number" name="twelfthPercentage" min="0" max="100" step="0.01" required>
            </div>
            <div class="form-group">
                <label for="btech">B.Tech Marksheet (Percentage):</label>
                <input type="file" name="btechMarksheet" id="btech" accept=".pdf,.jpg,.png" required>
                <input type="number" name="btechPercentage" min="0" max="100" step="0.01" required>
            </div>
            <div class="form-group">
                <label for="resume">Resume:</label>
                <input type="file" name="resume" id="resume" accept=".pdf" required>
            </div>
            <button type="submit">Upload</button>
        </form>
    </div>

    <script>
        // JavaScript code here (if needed)
    </script>
</body>

</html>
